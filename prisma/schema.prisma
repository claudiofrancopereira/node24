// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patrimonies {
  id      String @id @default(uuid())
  name    String
  address String

  latitude  Float
  longitude Float

  neighborhood String?
  zipcode      String?

  notes String?

  color String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  images Images[]

  reports Reports[]
}

model Images {
  id        String   @id @default(uuid())
  name      String
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  patrimonies   Patrimonies @relation(fields: [patrimoniesID], references: [id])
  patrimoniesID String
}

model Reports {
  id     String   @id @default(uuid())
  date   DateTime @unique
  number Int      @unique @default(autoincrement())

  vehicle       String
  reportOfficer String

  hLocation String
  hFinal    String

  address String
  nature  String

  description String
  outcome     String

  bopm String
  bopc String

  opened Boolean

  createAt DateTime @default(now())

  involves      Involves[]
  cars          Cars[]
  reportImages ReportImages[]

  patrimony   Patrimonies @relation(fields: [patrimonyID], references: [id])
  patrimonyID String
}

enum involvesCondition {
  VITIMA
  TESTEMUNHA
  AUTOR
  AUTORA
  PARTE_NAO_DEFINIDA
  PND
  SINDICADO

}

model Involves {
  id           String  @id @default(uuid())
  number       Int?    @default(1)
  condition    involvesCondition
  name         String?
  father       String?
  mother       String?
  dbirth       String?
  pbirth       String?
  color        String?
  sex          String?
  civilStatus  String?
  work         String?
  rgcpf        String?
  address      String?
  neighborhood String?
  city         String?
  state        String?
  phone        String?

  createAt DateTime @default(now())

  report   Reports @relation(fields: [reportID], references: [id])
  reportID String
}

model Cars {
  id       String  @id @default(uuid())
  number   Int?    @default(1)
  vessel   String?
  makebody String?
  color    String?
  year     String?
  plate    String?
  city     String?
  state    String?

  createAt DateTime @default(now())

  report   Reports @relation(fields: [reportID], references: [id])
  reportID String
}

model ReportImages {
  id        String    @id @default(uuid())
  path      String?
  createdAt DateTime? @default(now())

  reports  Reports @relation(fields: [reportID], references: [id])
  reportID String
}
